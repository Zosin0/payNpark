{
  "expo": {
    "name": "PayNPark",
    "slug": "fast-ticket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.fastticket"
    },
    "ios": {
      "bundleIdentifier": "com.fastticket"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "@zosin0/paynpark-host",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "O PayNPark usa a câmera para ler o QR code do estacionamento."
        }
      ]
    ]
  }
}
