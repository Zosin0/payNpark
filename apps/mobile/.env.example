# Copy this file to .env and fill in real values. Vars prefixed with
# EXPO_PUBLIC_ are inlined into the JS bundle at build time (Expo SDK 49+
# convention) - never put secrets here, only client-safe values.

# Base URL of the payNpark backend API.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google Maps JavaScript API key used by the WebView map in MapScreen.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
